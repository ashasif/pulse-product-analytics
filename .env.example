# Pulse Product Analytics
# Environment variable template
#
# Copy this file to .env for local development when credentials
# are required. Never commit real passwords or secrets.
#
# These variable names intentionally match
# src/ingestion/database.py::DatabaseConfig.

PULSE_DB_HOST=localhost
PULSE_DB_PORT=5432
PULSE_DB_NAME=pulse_warehouse
PULSE_DB_USER=pulse_app
PULSE_DB_PASSWORD=replace_with_local_password
PULSE_DB_CONNECT_TIMEOUT=10

# Deployment note:
# A hosted dashboard should use a dedicated LOGIN role that inherits
# the read-only pulse_reporting_reader group role rather than a broad
# warehouse application role.